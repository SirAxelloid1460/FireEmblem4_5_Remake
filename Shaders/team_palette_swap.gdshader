shader_type canvas_item;

// ============================================================
// team_palette_swap — recolor por equipo via LUT de 16 colores
// ============================================================
// Los map sprites usan la paleta GBA "Player" (16 colores, SRC). Este shader
// sustituye cada color de equipo por el de la paleta destino, manteniendo
// piel/metal/contorno (colores que coinciden con SRC pero son iguales en la
// paleta destino quedan igual). Ver docs/palettes/team_palettes.md.
//   team: 0=Player(identidad) 1=Enemy 2=Ally 3=Other 4=Used(ya actuo)
// Generado por tools (no editar a mano los arrays).

uniform int team = 0;

const vec3 SRC[16] = vec3[16](
	vec3(0.5020,0.6275,0.5020),
	vec3(0.3451,0.2824,0.4706),
	vec3(0.5647,0.7216,0.9098),
	vec3(0.8471,0.9098,0.9412),
	vec3(0.4392,0.3765,0.3765),
	vec3(0.6902,0.5647,0.3451),
	vec3(0.9725,0.9725,0.8157),
	vec3(0.2196,0.2196,0.5647),
	vec3(0.2196,0.3137,0.8784),
	vec3(0.1569,0.6275,0.9725),
	vec3(0.0941,0.9412,0.9725),
	vec3(0.9098,0.0627,0.0941),
	vec3(0.9725,0.9725,0.2510),
	vec3(0.5020,0.5333,0.4392),
	vec3(0.9725,0.9725,0.9725),
	vec3(0.2510,0.2196,0.2196));

const vec3 ENEMY[16] = vec3[16](
	vec3(0.5020,0.6275,0.5020),
	vec3(0.4078,0.2824,0.3765),
	vec3(0.7529,0.6588,0.7216),
	vec3(0.8784,0.8784,0.8784),
	vec3(0.4392,0.3765,0.3765),
	vec3(0.6902,0.5647,0.3451),
	vec3(0.9725,0.9725,0.8157),
	vec3(0.3765,0.1569,0.1255),
	vec3(0.6588,0.1882,0.1569),
	vec3(0.8784,0.0627,0.0627),
	vec3(0.9725,0.3137,0.2824),
	vec3(0.2196,0.8157,0.1882),
	vec3(0.9725,0.9725,0.2510),
	vec3(0.5020,0.5333,0.4392),
	vec3(0.9725,0.9725,0.9725),
	vec3(0.2510,0.2196,0.2196));

const vec3 ALLY[16] = vec3[16](
	vec3(0.5020,0.6275,0.5020),
	vec3(0.2196,0.3137,0.2196),
	vec3(0.5961,0.7843,0.5020),
	vec3(0.8471,0.9725,0.7216),
	vec3(0.3451,0.3451,0.3137),
	vec3(0.6275,0.5333,0.2510),
	vec3(0.9725,0.9725,0.7529),
	vec3(0.1255,0.3137,0.0627),
	vec3(0.0314,0.5647,0.0000),
	vec3(0.0941,0.8157,0.0627),
	vec3(0.3137,0.9725,0.2196),
	vec3(0.0000,0.4706,0.7843),
	vec3(0.8784,0.9725,0.1569),
	vec3(0.5020,0.5333,0.4392),
	vec3(0.9725,0.9725,0.9725),
	vec3(0.2196,0.2510,0.2196));

const vec3 OTHER[16] = vec3[16](
	vec3(0.5020,0.6275,0.5020),
	vec3(0.3451,0.2824,0.4706),
	vec3(0.8196,0.7098,0.2824),
	vec3(0.9843,0.8824,0.5765),
	vec3(0.4392,0.3765,0.3765),
	vec3(0.6902,0.5647,0.3451),
	vec3(0.9725,0.9725,0.8157),
	vec3(0.3255,0.2745,0.0000),
	vec3(0.4078,0.3882,0.0000),
	vec3(0.6078,0.5647,0.1098),
	vec3(0.8157,0.7059,0.2784),
	vec3(0.3804,0.3490,0.0000),
	vec3(0.9725,0.9725,0.2510),
	vec3(0.5020,0.5333,0.4392),
	vec3(0.9725,0.9725,0.9725),
	vec3(0.2510,0.2196,0.2196));

const vec3 USED[16] = vec3[16](
	vec3(0.5020,0.6275,0.5020),
	vec3(0.2510,0.2510,0.2510),
	vec3(0.4706,0.4706,0.4706),
	vec3(0.7216,0.7216,0.7216),
	vec3(0.3137,0.3137,0.3137),
	vec3(0.5020,0.5020,0.5020),
	vec3(0.7843,0.7843,0.7843),
	vec3(0.2824,0.2824,0.2824),
	vec3(0.3451,0.3451,0.3451),
	vec3(0.5961,0.5961,0.5961),
	vec3(0.7216,0.7216,0.7216),
	vec3(0.4392,0.4392,0.4392),
	vec3(0.7843,0.7843,0.7843),
	vec3(0.5020,0.5333,0.4392),
	vec3(0.8157,0.8157,0.8157),
	vec3(0.2510,0.2196,0.2196));

void fragment() {
	vec4 c = texture(TEXTURE, UV);
	if (c.a > 0.004 && team != 0) {
		for (int i = 0; i < 16; i++) {
			if (distance(c.rgb, SRC[i]) < 0.02) {
				if (team == 1) c.rgb = ENEMY[i];
				else if (team == 2) c.rgb = ALLY[i];
				else if (team == 3) c.rgb = OTHER[i];
				else c.rgb = USED[i];
				break;
			}
		}
	}
	COLOR = c;
}
