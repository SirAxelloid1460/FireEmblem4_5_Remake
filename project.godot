; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="FE4 FE5 Remake"
config/description="Remake fan híbrido de Fire Emblem 4 + 5 (port desde LT-maker)."
run/main_scene="res://Scenes/language.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.png"

[autoload]

AssetLoader="*res://Scripts/AssetLoader.gd"
GameMode="*res://Scripts/GameMode.gd"
Convoy="*res://Scripts/ConvoySystem.gd"
GameDB="*res://Scripts/GameDatabase.gd"
GameManager="*res://Scripts/GameManager.gd"
FadeCanvas="*res://Scripts/FadeCanvas.gd"
InputConfig="*res://Scripts/InputConfig.gd"
DialogueL10n="*res://Scripts/DialogueL10n.gd"

[debug]

gdscript/warnings/treat_warnings_as_errors=false

[display]

window/size/viewport_width=1200
window/size/viewport_height=800
window/stretch/mode="canvas_items"

[gui]

theme/custom_font="uid://cdcb6bwsvcsa1"

